<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="sw" tagdir="/WEB-INF/tags" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>${empty pageTitle ? 'ScriptWell' : pageTitle.concat(' | ScriptWell')}</title>
  <link rel="icon" href="${ctx}/assets/img/logo.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="${ctx}/assets/css/style.css" rel="stylesheet">
</head>
<body data-ctx="${ctx}">

<nav class="navbar navbar-expand-lg sw-nav sticky-top py-2">
  <div class="container">
    <a class="navbar-brand sw-brand" href="${ctx}/home"><img src="${ctx}/assets/img/logo.svg" alt="" width="32" class="me-2 mb-1">ScriptWell<span class="dot">.</span></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-3 ms-lg-3">
        <li class="nav-item"><a class="nav-link" href="${ctx}/home">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="${ctx}/books">Browse</a></li>
        <li class="nav-item"><a class="nav-link" href="${ctx}/books?sort=rating">Bestsellers</a></li>
      </ul>
      <form class="d-flex sw-search my-2 my-lg-0 me-auto" action="${ctx}/books" method="get" role="search">
        <input class="form-control" type="search" name="q" placeholder="Search title, author or ISBN" value="${fn:escapeXml(param.q)}">
        <button class="btn btn-ink px-3" type="submit"><i class="bi bi-search"></i></button>
      </form>
      <ul class="navbar-nav align-items-lg-center gap-lg-2">
        <li class="nav-item me-2">
          <a class="nav-link cart-link" href="${ctx}/cart" title="Cart"><i class="bi bi-bag fs-5"></i>
            <span id="cartBadge" class="badge rounded-pill cart-badge ${empty sessionScope.cartCount or sessionScope.cartCount == 0 ? 'd-none' : ''}">${sessionScope.cartCount}</span>
          </a>
        </li>
        <c:choose>
          <c:when test="${not empty sessionScope.user}">
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                <i class="bi bi-person-circle me-1"></i>${fn:escapeXml(sessionScope.user.firstName)}
              </a>
              <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                <li><span class="dropdown-item-text small text-muted">${fn:escapeXml(sessionScope.user.email)}</span></li>
                <li><hr class="dropdown-divider"></li>
                <c:if test="${sessionScope.user.admin}">
                  <li><a class="dropdown-item" href="${ctx}/admin"><i class="bi bi-speedometer2 me-2"></i>Admin dashboard</a></li>
                </c:if>
                <li><a class="dropdown-item" href="${ctx}/orders"><i class="bi bi-receipt me-2"></i>My orders</a></li>
                <li><a class="dropdown-item" href="${ctx}/cart"><i class="bi bi-bag me-2"></i>My cart</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="${ctx}/logout"><i class="bi bi-box-arrow-right me-2"></i>Sign out</a></li>
              </ul>
            </li>
          </c:when>
          <c:otherwise>
            <li class="nav-item"><a class="nav-link" href="${ctx}/login">Sign in</a></li>
            <li class="nav-item"><a class="btn btn-accent btn-sm px-3" href="${ctx}/register">Create account</a></li>
          </c:otherwise>
        </c:choose>
      </ul>
    </div>
  </div>
</nav>

<c:if test="${not empty sessionScope.flashMsg}">
  <div class="container mt-3">
    <div class="alert alert-${sessionScope.flashType} alert-dismissible fade show mb-0" role="alert">
      ${fn:escapeXml(sessionScope.flashMsg)}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  </div>
  <c:remove var="flashMsg" scope="session" />
  <c:remove var="flashType" scope="session" />
</c:if>
<main>
