<div class="admin-shell">
  <aside class="admin-side">
    <div class="side-title small text-uppercase mb-3 px-2" style="letter-spacing:.15em;color:#8d89a6">Admin panel</div>
    <a href="${ctx}/admin" class="${adminPage == 'dashboard' ? 'active' : ''}"><i class="bi bi-speedometer2"></i>Dashboard</a>
    <a href="${ctx}/admin/books" class="${adminPage == 'books' or adminPage == 'book-form' ? 'active' : ''}"><i class="bi bi-book"></i>Books</a>
    <a href="${ctx}/admin/orders" class="${adminPage == 'orders' ? 'active' : ''}"><i class="bi bi-receipt"></i>Orders</a>
    <a href="${ctx}/admin/inventory" class="${adminPage == 'inventory' ? 'active' : ''}"><i class="bi bi-box-seam"></i>Inventory</a>
    <a href="${ctx}/admin/users" class="${adminPage == 'users' ? 'active' : ''}"><i class="bi bi-people"></i>Customers</a>
    <hr class="border-secondary d-none d-lg-block">
    <a href="${ctx}/home"><i class="bi bi-shop"></i>View store</a>
  </aside>
  <div class="admin-main">
    <c:if test="${not empty error}"><div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>${fn:escapeXml(error)}</div></c:if>
